    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "firebase-admin": "^12.3.0",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "dotenv": "^16.4.5",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "typescript": "^5.5.3",
    "tsx": "^4.16.2",
    "@types/express": "^4.17.21",
    "@types/node-cron": "^3.0.11",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.15"
  },
  "private": true
