# ═══════════════════════════════════════════════════════════════════════════
# Serveur CHC MVP — Variables d'environnement
# ═══════════════════════════════════════════════════════════════════════════
# Copier ce fichier vers .env et remplir les valeurs.
# Ne JAMAIS commiter .env (contient des secrets).

# Port du serveur Express (nginx fait le reverse proxy HTTPS → ce port)
PORT=8080

# Chemin vers la clé de service Firebase Admin SDK
# Sur le VPS : /etc/hockey-club/service-account.json
# En local : chemin absolu vers le fichier JSON téléchargé depuis la console Firebase
GOOGLE_APPLICATION_CREDENTIALS=/etc/hockey-club/service-account.json

# ── Cycle de vote (optionnel, les valeurs par défaut sont ci-dessous) ──
# Délai entre la fin du match et l'ouverture automatique du vote (heures)
# VOTE_OPEN_DELAY_HOURS=2

# Durée pendant laquelle le vote reste ouvert (heures)
# VOTE_DURATION_HOURS=48

# Envoyer un rappel aux non-votants X heures avant la clôture
# REMINDER_BEFORE_HOURS=24

# Envoyer un rappel admin X heures avant le match si la feuille de présence est vide
# ADMIN_REMINDER_BEFORE_HOURS=1

# Envoi de l'e-mail d'invitation aux nouveaux membres, via Gmail SMTP
# (gratuit). SMTP_USER est l'adresse Gmail qui enverra les e-mails (ex:
# celle du club ou de l'admin). SMTP_APP_PASSWORD n'est PAS le mot de passe
# du compte Google — c'est un "mot de passe d'application" à générer sur
# https://myaccount.google.com/apppasswords (nécessite la validation en 2
# étapes activée sur ce compte Gmail).
SMTP_USER=ton.adresse@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Personnalisation de l'e-mail d'invitation.
CLUB_NAME=Châteaubourg Hockey Club
# URL publique (https) du logo du club, affiché en haut de l'e-mail.
# Facultatif — sans logo, le nom du club s'affiche en titre à la place.
CLUB_LOGO_URL=