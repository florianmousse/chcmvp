<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏭️ Prochain match"
        android:textSize="13sp"
        android:textColor="#888888"
        android:layout_alignParentTop="true" />

    <TextView
        android:id="@+id/next_match_opponent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?android:textColorPrimary"
        android:layout_below="@id/widget_title"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/next_match_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="?android:textColorSecondary"
        android:layout_below="@id/next_match_opponent"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/next_match_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="?android:textColorSecondary"
        android:layout_below="@id/next_match_date"
        android:layout_marginTop="2dp" />

</RelativeLayout>
