rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    function isClubMember() {
      return isActiveMember() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != 'reviewer';
    }

    function isAdmin() {
      return isActiveMember() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isReviewer() {
      return isActiveMember() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'reviewer';
    }
    function canReadTest(matchId) {
      return isActiveMember() && (isAdmin() || (isReviewer() &&
        get(/databases/$(database)/documents/test_matches/$(matchId)).data.get('reviewCreatedBy', '') == request.auth.uid));
    }

    // Append-only server journal. Clients, including admins, cannot alter it.
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Full isolated application, one namespace per review account.
    match /review_spaces/{spaceUid} {
      function canAccessSpace() {
        return isAdmin() || (isReviewer() && request.auth.uid == spaceUid);
      }
      allow read: if canAccessSpace();
      allow write: if false;
      match /{collection}/{document} {
        allow read: if canAccessSpace() && collection in [
          'users', 'teams', 'opponents', 'settings', 'seasons', 'matches', 'test_matches',
          'rankings_cache', 'player_stats', 'userBadges', 'ceremonies', 'audit_logs'
        ];
        allow write: if false;
      }
      match /matches/{matchId}/votes/{voterUid} {
        function validSandboxBallot() {
          let m = get(/databases/$(database)/documents/review_spaces/$(spaceUid)/matches/$(matchId)).data;
          let v = request.resource.data;
          return m.status == 'voting_open' && request.auth.uid in m.presentPlayerIds &&
            v.firstPlaceUid in m.presentPlayerIds && v.secondPlaceUid in m.presentPlayerIds && v.thirdPlaceUid in m.presentPlayerIds &&
            (m.get('allowSelfVote', false) || !(request.auth.uid in [v.firstPlaceUid, v.secondPlaceUid, v.thirdPlaceUid])) &&
            (m.get('votingOpensAt', null) == null || request.time >= m.votingOpensAt) &&
            (m.get('votingClosesAt', null) == null || request.time < m.votingClosesAt);
        }
        allow read: if canAccessSpace() && request.auth.uid == voterUid;
        allow create: if canAccessSpace() && request.auth.uid == voterUid &&
          request.resource.data.keys().hasAll(['voterUid', 'firstPlaceUid', 'secondPlaceUid', 'thirdPlaceUid', 'votedAt']) &&
          request.resource.data.keys().hasOnly(['voterUid', 'firstPlaceUid', 'secondPlaceUid', 'thirdPlaceUid', 'votedAt']) &&
          request.resource.data.voterUid == voterUid && request.resource.data.votedAt == request.time &&
          request.resource.data.firstPlaceUid != request.resource.data.secondPlaceUid &&
          request.resource.data.firstPlaceUid != request.resource.data.thirdPlaceUid &&
          request.resource.data.secondPlaceUid != request.resource.data.thirdPlaceUid && validSandboxBallot();
        allow update, delete: if false;
      }
      match /matches/{matchId}/{collection}/{document} {
        allow read: if canAccessSpace() && collection in ['results', 'playerStats'];
        allow write: if false;
      }
      match /test_matches/{matchId}/{collection}/{document} {
        allow read: if canAccessSpace() && collection in ['results', 'playerStats', 'votes'];
        allow write: if false;
      }
      match /player_stats/{uid}/history/{matchId} {
        allow read: if canAccessSpace();
        allow write: if false;
      }
      match /ceremonies/{id}/votes/{uid} {
        allow read: if canAccessSpace() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // A member may register at most ten devices; validate every list element.
    function validTokenAt(tokens, i) {
      return tokens.size() <= i || (tokens[i] is string && tokens[i].size() > 0 &&
        tokens[i].size() <= 4096 && tokens[i].matches('^[^\\s]+$'));
    }
    function validTokens(tokens) {
      return tokens is list && tokens.size() <= 10 && tokens.toSet().size() == tokens.size() &&
        validTokenAt(tokens, 0) &&
        validTokenAt(tokens, 1) &&
        validTokenAt(tokens, 2) &&
        validTokenAt(tokens, 3) &&
        validTokenAt(tokens, 4) &&
        validTokenAt(tokens, 5) &&
        validTokenAt(tokens, 6) &&
        validTokenAt(tokens, 7) &&
        validTokenAt(tokens, 8) &&
        validTokenAt(tokens, 9);
    }

    // ---------- users ----------
    match /users/{userId} {
      // Lire sa propre fiche permet aussi d'afficher proprement un compte
      // désactivé ou sans fiche, sans ouvrir les autres données du club.
      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId);
      allow create, delete: if false;
      // Only push-token maintenance remains direct. Profile edits use the audited API.
      allow update: if isActiveMember() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens']) && validTokens(request.resource.data.fcmTokens);
    }

    // ---------- settings (barème, durée de vote, délai de rappel...) ----------
    match /settings/{doc} {
      allow read: if isClubMember();
      allow write: if false; // audited API only
    }

    // ---------- teams ----------
    match /teams/{teamId} {
      allow read: if isClubMember();
      allow write: if false; // audited API only
    }

    // ---------- opponents ----------
    match /opponents/{opponentId} {
      allow read: if isClubMember();
      allow write: if false; // audited API only
    }

    // ---------- seasons ----------
    match /seasons/{seasonId} {
      allow read: if isClubMember();
      allow write: if false; // audited API only
    }

    // ---------- matches ----------
    match /matches/{matchId} {
      allow read: if isClubMember();
      allow create, update, delete: if false; // audited API only

      // ---------- votes (sous-collection) ----------
      // Un vote ne peut être créé que par son auteur, une seule fois, et uniquement
      // pendant que le vote est ouvert. Personne ne peut lire les votes individuels
      // des autres : seule une Cloud Function (Admin SDK, hors règles) agrège les résultats.
      match /votes/{voterUid} {
        function validParticipation() {
          let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
          let v = request.resource.data;
          return m.status == 'voting_open' &&
            request.auth.uid in m.presentPlayerIds &&
            v.firstPlaceUid in m.presentPlayerIds &&
            v.secondPlaceUid in m.presentPlayerIds &&
            v.thirdPlaceUid in m.presentPlayerIds &&
            (m.get('allowSelfVote', false) == true ||
              !(request.auth.uid in [v.firstPlaceUid, v.secondPlaceUid, v.thirdPlaceUid])) &&
            (m.get('votingOpensAt', null) == null || request.time >= m.votingOpensAt) &&
            (m.get('votingClosesAt', null) == null || request.time < m.votingClosesAt);
        }
        allow read: if isSignedIn() && request.auth.uid == voterUid;
        allow create: if isActiveMember() && !isReviewer() &&
          request.auth.uid == voterUid &&
          request.resource.data.keys().hasAll(['voterUid', 'firstPlaceUid', 'secondPlaceUid', 'thirdPlaceUid', 'votedAt']) &&
          request.resource.data.keys().hasOnly(['voterUid', 'firstPlaceUid', 'secondPlaceUid', 'thirdPlaceUid', 'votedAt']) &&
          request.resource.data.voterUid == voterUid &&
          request.resource.data.votedAt == request.time &&
          validParticipation() &&
          request.resource.data.firstPlaceUid != request.resource.data.secondPlaceUid &&
          request.resource.data.firstPlaceUid != request.resource.data.thirdPlaceUid &&
          request.resource.data.secondPlaceUid != request.resource.data.thirdPlaceUid;
        allow update, delete: if false; // un vote est définitif
      }

      // Résultats agrégés : lecture publique aux membres, écriture réservée au backend (Admin SDK).
      match /results/{doc} {
        allow read: if isClubMember();
        allow write: if false; // uniquement via Cloud Function avec les privilèges admin
      }

      // Stats individuelles (buts, passes, cartons) - saisies par l'admin.
      match /playerStats/{playerId} {
        allow read: if isClubMember();
        allow create, update, delete: if false;
      }
    }

    // ---------- rankings_cache ----------
    // Collections séparées : aucun filtre client n'est nécessaire pour protéger
    // les tests, y compris avec une ancienne application mobile.
    match /test_matches/{matchId} {
      allow read: if isActiveMember() && (isAdmin() ||
        (isReviewer() && resource.data.get('reviewCreatedBy', '') == request.auth.uid));
      allow write: if false;
      match /{collection}/{id} {
        allow read: if collection in ['votes', 'results', 'playerStats'] && canReadTest(matchId);
        allow write: if false;
      }
    }

    match /rankings_cache/{scope} {
      allow read: if isClubMember();
      allow write: if false; // recalculé par Cloud Function
    }

    // ---------- player_stats (all-time, alimenté par computeMatchResults) ----------
    match /player_stats/{uid} {
      allow read: if isClubMember();
      allow write: if false;

      match /history/{matchId} {
        allow read: if isClubMember();
        allow write: if false;
      }
    }

    // ---------- userBadges ----------
    match /ceremonies/{eventId} {
      allow read: if isClubMember() && (isAdmin() || resource.data.status != 'draft');
      allow write: if false;
      match /votes/{uid} {
        allow read: if isActiveMember() && request.auth.uid == uid;
        allow write: if false; // validation et clôture atomiques côté serveur
      }
    }

    match /userBadges/{userId} {
      allow read: if isClubMember();
      allow write: if false; // calcul serveur ; empêche de rétablir un badge révoqué
    }
  }
}
