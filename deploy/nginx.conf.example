# À placer dans /etc/nginx/sites-available/hockey-club puis lier dans
# sites-enabled. Remplace chc-mvp.duckdns.org par ton propre sous-domaine
# DuckDNS (gratuit, sans carte bancaire — voir DEPLOY_ORACLE_VPS.md § 0).
# Lance `sudo certbot --nginx -d chc-mvp.duckdns.org` après coup pour le
# HTTPS automatique (voir DEPLOY_ORACLE_VPS.md étape 7).

server {
    listen 80;
    server_name chc-mvp.duckdns.org;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
